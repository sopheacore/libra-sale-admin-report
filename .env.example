# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Target Telegram Group ID (where the sales team and admin report)
# Example: -1001234567890
TELEGRAM_GROUP_ID=

# Admin User IDs (comma-separated Telegram User IDs allowed to trigger admin commands)
# Example: 12345678,87654321
ADMIN_USER_IDS=

# Weekly Report Schedule (Cron expression)
# Default: Every Friday at 17:30 (5:30 PM) Phnom Penh / ICT time
# Format: MINUTE HOUR DAY-OF-MONTH MONTH DAY-OF-WEEK (0=Sun, 5=Fri)
WEEKLY_REPORT_CRON=30 17 * * 5

# Timezone (Default: Asia/Phnom_Penh)
TIMEZONE=Asia/Phnom_Penh

# Database file location
DB_PATH=./data/sales_reports.db
